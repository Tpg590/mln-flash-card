{
  "version": 2,
  "name": "mln-flash-card",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/data.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/data",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app.js",
      "has": [
        {
          "type": "header",
          "key": "Sec-Fetch-Dest",
          "value": "document"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/style.css",
      "has": [
        {
          "type": "header",
          "key": "Sec-Fetch-Dest",
          "value": "document"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/((?!style.css$|app.js$).+)",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(data.js|data)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(style.css|app.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
